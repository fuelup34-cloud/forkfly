# Copy to .env, or run `npm run setup` to create it with a fresh secret.
DATABASE_URL=postgres://YOUR_MAC_USERNAME@localhost:5432/forkfly
# At least 32 random characters. Changing it signs everyone out.
BETTER_AUTH_SECRET=
# The address people open the app at.
BETTER_AUTH_URL=http://localhost:5190
# Optional: extra comma-separated origins allowed to sign in, e.g. https://forkfly.example
TRUSTED_ORIGINS=
# Set to true only when running behind a hosting proxy that sets X-Forwarded-For.
TRUST_PROXY=false
