# Copy to .env, or run `npm run setup` to create it with a fresh secret.
DATABASE_URL=postgres://YOUR_MAC_USERNAME@localhost:5432/forkfly
# At least 32 random characters. Changing it signs everyone out.
BETTER_AUTH_SECRET=
# The address people open the app at.
BETTER_AUTH_URL=http://localhost:5190
# Optional: extra comma-separated origins allowed to sign in, e.g. https://forkfly.example
TRUSTED_ORIGINS=
# Set to true only when running behind a hosting proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# Time zone for "today" and day boundaries on the admin dashboard.
PLATFORM_TIMEZONE=America/New_York

# Card payments at checkout (Stripe). Leave empty for a demo checkout that takes no payment.
# Use test keys (sk_test_… / pk_test_…) from https://dashboard.stripe.com/test/apikeys while developing.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Optional: lets Stripe tell the server about payments even if the customer's tab closes.
# Locally: `stripe listen --forward-to localhost:5190/api/stripe/webhook` prints this secret.
STRIPE_WEBHOOK_SECRET=

# Email (sign-up codes, password resets). Not connected yet: codes are printed in the server log
# as "[mail] …" until Resend is set up in server/mail.js.
RESEND_API_KEY=
MAIL_FROM=
